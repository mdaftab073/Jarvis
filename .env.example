# =============================================================================
# Jarvis Platform — Environment Configuration Template
# =============================================================================
# Copy this file to '.env' and populate with deployment-specific secrets.
# NEVER commit the active '.env' file to source control.
#
# Generate random secrets safely with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Generate Fernet encryption key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# =============================================================================

# -----------------------------------------------------------------------------
# Environment & Deployment Mode
# -----------------------------------------------------------------------------
# Options: 'production', 'development', 'test'
# In 'production', strict validation is enforced: placeholders are rejected,
# JWT secret must be >= 32 bytes, Fernet key must be valid, and ALLOWED_ORIGINS must not be '*'.
ENVIRONMENT=production

# Host port published for the Jarvis API service in Docker Compose
JARVIS_PORT=8000

# -----------------------------------------------------------------------------
# Relational Database (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_DB=jarvis
POSTGRES_USER=jarvis
# Use a high-entropy random password for every deployment environment
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Primary database connection string for SQLAlchemy
# In Docker Compose, jarvis-api constructs this automatically from the credentials above.
# Set explicitly when running backend outside Docker Compose or connecting to AWS RDS:
# DATABASE_URL=postgresql+psycopg2://jarvis:password@localhost:5432/jarvis
DATABASE_URL=postgresql+psycopg2://jarvis:replace-with-a-long-random-password@postgres:5432/jarvis

# -----------------------------------------------------------------------------
# Artificial Intelligence & LLM Service (Groq Cloud)
# -----------------------------------------------------------------------------
# Required by Academic Director Agent, RAG retrieval, and Study Plan generation
GROQ_API_KEY=replace-with-your-groq-api-key

# -----------------------------------------------------------------------------
# Google OAuth 2.0 Authentication
# -----------------------------------------------------------------------------
# Google Web OAuth 2.0 Client ID for validating Google ID tokens from the frontend
GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id

# -----------------------------------------------------------------------------
# JSON Web Token (JWT) Security
# -----------------------------------------------------------------------------
# Cryptographic secret for signing HS256 access and refresh tokens (minimum 32 bytes in production)
JWT_SECRET_KEY=replace-with-at-least-32-random-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Enforce student authentication on all protected API routes (MUST be true in production)
REQUIRE_AUTHENTICATED_STUDENT=true

# -----------------------------------------------------------------------------
# Data Security & Credential Encryption
# -----------------------------------------------------------------------------
# URL-safe base64-encoded 32-byte Fernet key used to encrypt stored credentials and session cookies at rest
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONNECTOR_ENCRYPTION_KEY=replace-with-a-generated-fernet-key

# -----------------------------------------------------------------------------
# Administrative Monitoring & Metrics
# -----------------------------------------------------------------------------
# Secret token required to access the /api/metrics/summary administrative endpoint
METRICS_ADMIN_TOKEN=replace-with-a-long-random-admin-token

# -----------------------------------------------------------------------------
# Cross-Origin Resource Sharing (CORS)
# -----------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (e.g. 'https://app.jarvis.com,http://localhost:5173')
# Wildcard '*' is strictly prohibited in production mode
ALLOWED_ORIGINS=http://localhost:5173

# -----------------------------------------------------------------------------
# Vector Database (ChromaDB) & Model Cache
# -----------------------------------------------------------------------------
# In Docker Compose, the service name is 'chroma' on port 8000
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_SSL=false
# Local persistent directory used when CHROMA_HOST is omitted
CHROMA_PERSISTENT_DIRECTORY=chroma_db
# Directory where SentenceTransformer embedding models are cached
HF_HOME=/opt/huggingface

# -----------------------------------------------------------------------------
# File Storage & Upload Limits
# -----------------------------------------------------------------------------
# Maximum allowed size for PDF course materials in bytes (default: 25 MB)
MAX_UPLOAD_SIZE_BYTES=26214400

# -----------------------------------------------------------------------------
# Background Worker & Job Scheduler
# -----------------------------------------------------------------------------
BACKGROUND_JOBS_ENABLED=true
# Jobs with no heartbeat exceeding this threshold are automatically failed and recovered
JOB_RUNNING_TIMEOUT_MINUTES=30
JOB_POLL_INTERVAL_SECONDS=5
WORKER_HEARTBEAT_INTERVAL_SECONDS=15
REMINDER_JOB_INTERVAL_SECONDS=3600
ANALYTICS_JOB_INTERVAL_SECONDS=21600

# -----------------------------------------------------------------------------
# Frontend Application Settings (Used during Vite build or in frontend/.env)
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id