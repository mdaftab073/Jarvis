# PostgreSQL container settings; Compose builds the API DATABASE_URL from these values.
POSTGRES_DB=jarvis
POSTGRES_USER=jarvis
# Use a unique, long password for every deployed environment.
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Required by the AI features; set a valid provider API key.
GROQ_API_KEY=replace-with-your-groq-api-key
# Host port published for the API container.
JARVIS_PORT=8000
# Secret required by the administrative metrics endpoint.
METRICS_ADMIN_TOKEN=replace-with-a-long-random-admin-token
# Google OAuth Web client ID used by the frontend sign-in flow.
GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id
# Random signing secret; production requires at least 32 bytes.
JWT_SECRET_KEY=replace-with-at-least-32-random-bytes
# Comma-separated exact browser origins; do not use a wildcard.
ALLOWED_ORIGINS=replace-with-frontend-origin
# JWT signing algorithm and token lifetimes.
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
# Compose pins REQUIRE_AUTHENTICATED_STUDENT=true for the API container.
# Connector credentials use a Fernet key. Keep it stable to decrypt stored credentials.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONNECTOR_ENCRYPTION_KEY=replace-with-a-generated-fernet-key