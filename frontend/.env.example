# Jarvis Frontend — Environment Configuration Template
# Copy this file to 'frontend/.env' or set environment variables during Vite build.

# Backend API base URL (in production, set to your API domain, e.g. https://api.jarvis.example.com)
VITE_API_BASE_URL=http://localhost:8000

# Google OAuth 2.0 Web Client ID matching the backend GOOGLE_CLIENT_ID configuration
VITE_GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id
